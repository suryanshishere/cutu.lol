{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outmatch",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/admin", "/admin/", "/admin.html", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISIT_COUNTER",
        "class_name": "VisitCounter"
      },
      {
        "name": "EMAIL_INTAKE",
        "class_name": "EmailIntake"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisitCounter"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EmailIntake"]
    }
  ],
  "routes": [
    {
      "pattern": "cutu.suryansh.lol",
      "zone_name": "suryansh.lol",
      "custom_domain": true
    }
  ]
}
